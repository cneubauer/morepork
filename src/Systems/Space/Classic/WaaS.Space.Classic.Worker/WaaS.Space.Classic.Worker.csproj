<!-- Sdk.Web, not Sdk.Worker: Kubernetes probes need an HTTP endpoint, and the
     shared framework this SDK references also carries KeyPerFile configuration.
     The standalone KeyPerFile package only exists as an 11.0 preview, so this
     keeps the whole dependency graph on stable 10.0. -->
<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Microsoft.Extensions.Http dropped: the web SDK's shared framework already
         provides it (NU1510). -->
    <PackageReference Include="Temporalio.Extensions.Hosting" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WaaS.Space.Classic.Workflow\WaaS.Space.Classic.Workflow.csproj" />
    <ProjectReference Include="..\..\WaaS.Space.Workflow\WaaS.Space.Workflow.csproj" />
    <ProjectReference Include="..\..\..\Webshield\WaaS.Webshield.DesiredState\WaaS.Webshield.DesiredState.csproj" />
  </ItemGroup>

</Project>
